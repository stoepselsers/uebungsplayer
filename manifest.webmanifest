{
  "name": "Übungsplayer",
  "short_name": "Übungsplayer",
  "description": "Musik und Videos langsamer abspielen, Tonart ändern, loopen, aufnehmen und exportieren.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#110e18",
  "theme_color": "#110e18",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "media", "accept": ["audio/*", "video/*", ".mp3", ".m4a", ".wav", ".mp4", ".mov"] }
      ]
    }
  }
}
